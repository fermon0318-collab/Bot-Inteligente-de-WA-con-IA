# ============================================================================
# Elorai · variables de entorno
#
# En desarrollo:  copia este archivo a server/.env
# En producción:  deploy.sh lo copia a /etc/elorai/elorai.env y genera los
#                 secretos automáticamente; tú solo completas Google y Stripe.
#
# Nunca subas el archivo real al repositorio.
# ============================================================================

NODE_ENV=production
PORT=3000
# En Hetzner (detrás de nginx) va 127.0.0.1. En Railway (sin nginx delante)
# tiene que ser 0.0.0.0, o el proxy de borde de Railway no llega al contenedor.
HOST=127.0.0.1

# URL pública, sin barra final. Debe coincidir con el dominio del certificado.
# En Railway puedes dejarla vacía en el primer despliegue: si RAILWAY_PUBLIC_DOMAIN
# existe (Railway lo define solo), se usa como respaldo automáticamente.
PUBLIC_URL=https://elorai.io

# --- Base de datos ----------------------------------------------------------
# En Railway, el plugin de PostgreSQL ya define DATABASE_URL: no hace falta
# copiar nada, solo referenciar la variable desde el servicio en su dashboard.
DATABASE_URL=postgres://elorai:CLAVE@127.0.0.1:5432/elorai
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Archivos subidos (Bloque F) ---------------------------------------------
# Carpeta donde se guardan los adjuntos antes de subirlos a Meta.
# En Railway, monta un Volume en esta ruta o los archivos se perderán en cada
# despliegue (el filesystem del contenedor es efímero).
UPLOADS_DIR=

# --- Secretos ---------------------------------------------------------------
# Genera cada uno con: openssl rand -hex 32
#
# SESSION_SECRET  firma las cookies de sesión. Cambiarlo cierra todas las sesiones.
# ENCRYPTION_KEY  cifra en la base los tokens de Meta y las API Key de IA.
#                 ⚠️  Si lo pierdes, esas credenciales son irrecuperables y los
#                     clientes tendrán que volver a introducirlas. Guárdalo aparte.
SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_DAYS=30

# --- Google OAuth (opcional al arrancar) -------------------------------------
# Mientras estas dos falten, el botón "Acceder con Google" redirige con un
# aviso en vez de romper el arranque del servidor. Complétalas cuando tengas
# la URL pública real, tal como la pantalla de consentimiento de Google exige.
# https://console.cloud.google.com/apis/credentials
#   Tipo: ID de cliente de OAuth → Aplicación web
#   Origen autorizado:        https://elorai.io  (o tu dominio de Railway)
#   URI de redirección:       https://elorai.io/auth/google/callback
#                             (debe coincidir carácter por carácter)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cobros -------------------------------------------------------------------
# Proveedor activo. 'none' (por defecto) deja pasar a cualquier cuenta con
# sesión sin cobrar nada — así el producto puede publicarse y usarse antes de
# tener una pasarela lista. Cambia a 'stripe' (o al adaptador de Wompi cuando
# exista) en cuanto la tengas configurada.
BILLING_PROVIDER=none

# --- Stripe (solo si BILLING_PROVIDER=stripe) --------------------------------
# Claves:   https://dashboard.stripe.com/apikeys
# Precios:  https://dashboard.stripe.com/products  (crea dos precios recurrentes)
# Webhook:  https://dashboard.stripe.com/webhooks
#   Endpoint:  https://elorai.io/api/billing/webhook
#   Eventos:   checkout.session.completed, customer.subscription.created,
#              customer.subscription.updated, customer.subscription.deleted,
#              invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Días de prueba gratis. 0 = sin prueba.
STRIPE_TRIAL_DAYS=0

# --- Accesos sin suscripción ------------------------------------------------
# Correos que entran al panel sin pagar: fundadores, soporte, demos.
# Separados por comas.
BILLING_BYPASS_EMAILS=

# --- Contacto ---------------------------------------------------------------
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
