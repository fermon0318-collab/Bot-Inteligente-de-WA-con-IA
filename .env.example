# ============================================================================
# ApolAI · variables de entorno
#
# En desarrollo:  copia este archivo a server/.env
# En producción:  deploy.sh lo copia a /etc/apolai/apolai.env y genera los
#                 secretos automáticamente; tú solo completas Google y Stripe.
#
# Nunca subas el archivo real al repositorio.
# ============================================================================

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# URL pública, sin barra final. Debe coincidir con el dominio del certificado.
PUBLIC_URL=https://apolai.io

# --- Base de datos ----------------------------------------------------------
DATABASE_URL=postgres://apolai:CLAVE@127.0.0.1:5432/apolai
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Secretos ---------------------------------------------------------------
# Genera cada uno con: openssl rand -hex 32
#
# SESSION_SECRET  firma las cookies de sesión. Cambiarlo cierra todas las sesiones.
# ENCRYPTION_KEY  cifra en la base los tokens de Meta y las API Key de IA.
#                 ⚠️  Si lo pierdes, esas credenciales son irrecuperables y los
#                     clientes tendrán que volver a introducirlas. Guárdalo aparte.
SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_DAYS=30

# --- Google OAuth -----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
#   Tipo: ID de cliente de OAuth → Aplicación web
#   Origen autorizado:        https://apolai.io
#   URI de redirección:       https://apolai.io/auth/google/callback
#                             (debe coincidir carácter por carácter)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe -----------------------------------------------------------------
# Claves:   https://dashboard.stripe.com/apikeys
# Precios:  https://dashboard.stripe.com/products  (crea dos precios recurrentes)
# Webhook:  https://dashboard.stripe.com/webhooks
#   Endpoint:  https://apolai.io/api/billing/webhook
#   Eventos:   checkout.session.completed, customer.subscription.created,
#              customer.subscription.updated, customer.subscription.deleted,
#              invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Días de prueba gratis. 0 = sin prueba.
STRIPE_TRIAL_DAYS=0

# Proveedor de cobros. Hoy solo 'stripe'; cambiarlo exige un adaptador nuevo
# en server/src/billing/ (ver el comentario de billing/index.js).
BILLING_PROVIDER=stripe

# --- Accesos sin suscripción ------------------------------------------------
# Correos que entran al panel sin pagar: fundadores, soporte, demos.
# Separados por comas.
BILLING_BYPASS_EMAILS=

# --- Contacto ---------------------------------------------------------------
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
